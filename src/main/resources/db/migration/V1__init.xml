<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1" author="user">

        <!-- Users -->
        <createTable tableName="users">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="VARCHAR(200)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <!-- Skill Categories -->
        <createTable tableName="skill_categories">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <!-- Skills -->
        <createTable tableName="skills">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="category_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="skills"
                baseColumnNames="category_id"
                referencedTableName="skill_categories"
                referencedColumnNames="id"
                constraintName="fk_skill_category"/>

        <!-- Profiles -->
        <createTable tableName="profiles">
            <column name="id" type="UUID">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(150)"/>
            <column name="experience" type="INT"/>
            <column name="description" type="TEXT"/>
            <column name="work_radius_km" type="INT"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="profiles"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_profile_user"/>

        <!-- Profile Skills -->
        <createTable tableName="profile_skills">
            <column name="profile_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="skill_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="profile_skills"
                baseColumnNames="profile_id"
                referencedTableName="profiles"
                referencedColumnNames="id"
                constraintName="fk_profile_skills_profile"/>

        <addForeignKeyConstraint
                baseTableName="profile_skills"
                baseColumnNames="skill_id"
                referencedTableName="skills"
                referencedColumnNames="id"
                constraintName="fk_profile_skills_skill"/>

        <addUniqueConstraint tableName="profile_skills"
                             columnNames="profile_id, skill_id"
                             constraintName="uk_profile_skill"/>

    </changeSet>

</databaseChangeLog>
